# Public application origin used as the email-confirmation callback base.
NEXT_PUBLIC_SITE_URL=

# Public Supabase project configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase credential for mentor circuit-breaker and
# classification operations. Never expose this to browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only AI provider configuration; required to enable AI assistance.
GOOGLE_GENERATIVE_AI_API_KEY=
AI_MENTOR_MODEL=gemini-3.8-flash
