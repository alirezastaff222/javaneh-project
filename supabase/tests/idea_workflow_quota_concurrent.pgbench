BEGIN;
SET LOCAL ROLE authenticated;
SELECT pg_catalog.set_config(
  'request.jwt.claim.sub', 'a9800000-0000-4000-8000-000000000001', true
);
SELECT pg_catalog.pg_sleep(0.1);
WITH attempt AS MATERIALIZED (
  SELECT public.create_idea(pg_catalog.gen_random_uuid()) AS result
)
INSERT INTO public.m9r8_quota_concurrency_outcomes (
  client_id, outcome, idea_id
)
SELECT :client_id, attempt.result->>'outcome',
       NULLIF(attempt.result->>'idea_id', '')::uuid
  FROM attempt;
COMMIT;
