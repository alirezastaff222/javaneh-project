BEGIN;
SELECT pg_catalog.set_config('request.jwt.claim.sub', ':user_id', true);
SELECT pg_catalog.pg_sleep(0.1);
WITH edit_result AS (
  SELECT public.edit_submitted_idea(
    ':idea_id'::uuid,
    pg_catalog.gen_random_uuid(),
    ':expected_revision'::integer,
    pg_catalog.jsonb_build_array(
      pg_catalog.jsonb_build_object(
        'stage_number', 1,
        'data', pg_catalog.jsonb_build_object(
          'content', 'concurrent dossier edit ' || pg_catalog.pg_backend_pid()::text
        )
      )
    )
  ) AS response
)
INSERT INTO public.m9r10_dossier_concurrency_outcomes (backend_pid, outcome)
  SELECT pg_catalog.pg_backend_pid(), edit_result.response->>'outcome'
    FROM edit_result;
COMMIT;
