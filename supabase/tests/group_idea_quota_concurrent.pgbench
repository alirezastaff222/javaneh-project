BEGIN;
SET LOCAL ROLE authenticated;
SELECT pg_catalog.set_config(
  'request.jwt.claim.sub', 'a8100000-0000-4000-8000-000000000001', true
);
SELECT pg_catalog.set_config(
  'request.jwt.claims',
  '{"sub":"a8100000-0000-4000-8000-000000000001","email":"group-quota-race@test.invalid"}',
  true
);
SELECT pg_catalog.pg_sleep(0.1);
WITH attempt AS MATERIALIZED (
  SELECT public.create_group_idea(
    state.group_id, pg_catalog.gen_random_uuid()
  ) AS result
  FROM public.group_quota_race_state AS state
)
INSERT INTO public.group_quota_race_outcomes (
  client_id, outcome, idea_id
)
SELECT :client_id,
       attempt.result->>'outcome',
       NULLIF(attempt.result->>'idea_id', '')::uuid
FROM attempt;
COMMIT;
