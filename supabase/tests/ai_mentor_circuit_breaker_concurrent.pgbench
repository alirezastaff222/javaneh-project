BEGIN;
SET LOCAL ROLE service_role;
WITH admission AS (
  SELECT public.admit_mentor_provider_call(
    'vercel-ai-gateway:test/concurrency-model',
    pg_catalog.gen_random_uuid()
  ) AS result
)
INSERT INTO public.m9r12_mentor_circuit_probe_outcomes (
  client_id, outcome, state
)
SELECT :client_id, result->>'outcome', result->>'state'
  FROM admission;
COMMIT;
